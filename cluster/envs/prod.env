# Settings for the prod cluster. Sourced by create.sh. Sizes are a starting point: review before use.
ENV=prod
CLUSTER_NAME=prod
NET_NAME=prod
NET_BRIDGE=virbr-prod
NET_GATEWAY=10.7.0.1          # libvirt NAT network 10.7.0.0/24
NODE_NAME=prod-cp1
NODE_IP=10.7.0.10             # DHCP reservation by MAC
NODE_MAC=52:54:00:07:00:10
VCPUS=2
MEM_MB=4096
DISK_GB=20
